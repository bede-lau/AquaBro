# ── AquaBro environment ──────────────────────────────────────────────
# Copy to .env and fill. Every integration degrades gracefully: a missing
# key => that channel runs in MOCK mode and the app still works for demo.

# ── Core ────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Public base URL reachable from the outside world (ngrok tunnel target).
# Used to build ElevenLabs webhook URLs. Leave blank to skip voice tool wiring.
PUBLIC_BASE_URL=http://localhost:8000

# ── Postgres ────────────────────────────────────────────────────────
POSTGRES_USER=aquabro
POSTGRES_PASSWORD=aquabro
POSTGRES_DB=aquabro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aquabro:aquabro@localhost:5432/aquabro

# ── OpenWeatherMap (Context Agent: ambient thermal drift forecast) ──
# https://openweathermap.org/api  (free tier)
OPENWEATHER_API_KEY=
# Current-weather endpoint (standard free key, no 3.0 subscription needed).
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
# Puchong, Selangor
OWM_LAT=3.0333
OWM_LON=101.6158

# ── Telegram (async diagnostic alerts) ──────────────────────────────
# @BotFather -> /newbot. Chat id: message the bot, then curl getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── ElevenLabs (3AM voice co-pilot escalation) ──────────────────────
# https://elevenlabs.io  Conversational AI agent id + API key.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Set true only when ngrok tunnel is up + agent tool is wired.
VOICE_ENABLED=false

# ── Vision / data replay ────────────────────────────────────────────
# Path to Zenodo Tilapia-RAS assets. If absent => synthetic telemetry.
DATA_DIR=./data
VISION_CLIPS_DIR=./data/clips
TELEMETRY_CSV=./data/meta_tilapia_set.csv
# "motion" (default, no weights) | "yolo" (needs weights on VISION_YOLO_WEIGHTS)
VISION_DETECTOR=motion
VISION_YOLO_WEIGHTS=
# RTSP-sim broadcast FPS
VISION_FPS=15
# Telemetry ingest cadence (seconds)
TELEMETRY_INTERVAL=2.0
